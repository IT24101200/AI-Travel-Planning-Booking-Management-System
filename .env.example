# Copy to a local .env file. Never commit the copied file or real secret values.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
DATABASE_URL=Host=localhost;Port=5432;Database=travel_booking_db;Username=postgres;Password=
# Demo catalogue importer safety: both explicit settings are required for writes.
# Allowed DEMO_CATALOGUE_ENVIRONMENT values: DEMO, DEVELOPMENT, TEST.
# Keep the defaults until the database target is independently approved.
DEMO_CATALOGUE_ENVIRONMENT=UNKNOWN
DEMO_CATALOGUE_WRITE_ENABLED=false
JWT__KEY=
JWT__ISSUER=AI-Travel-Planning-API
JWT__AUDIENCE=AI-Travel-Planning-Clients
STAFFSECRETCODE=
AGENT_SERVICE_URL=http://127.0.0.1:8005
AGENT_SERVICE_API_KEY=
AgentService__ConnectionTimeoutSeconds=120
AgentService__PipelineTimeoutSeconds=180
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
Currency__UsdToLkrRate=300
STRIPE_SECRET_KEY=sk_test_

# Python/FastAPI
BACKEND_URL=http://127.0.0.1:5138
BACKEND_API_URL=http://127.0.0.1:5138
GOOGLE_API_KEY_ITINERARY=
GEMINI_API_KEY=
PORT=8005

# React (Vite exposes only VITE_* values to browser code)
VITE_API_BASE_URL=http://localhost:5138/api

# Flutter: pass this at runtime; do not put Stripe secret keys here.
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5138/api
# flutter run --dart-define=STRIPE_PUBLISHABLE_KEY=pk_test_
